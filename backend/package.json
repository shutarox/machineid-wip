{
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "h": "jq '.scripts' package.json | grep -v '#internal'",
    "preinstall": "only-allow pnpm #internal",
    "script": "tsx -r tsconfig-paths/register",
    "dev": "node ../tools/portcheck.js ${BACKEND_PORT:-8080} && node ../tools/pm2check.js ${PM2_BACKEND_NAME:-backend} && pm2 start 'bash script/dev-watch.sh' --log-date-format 'YYYY-MM-DD HH:mm:ss.SSS' --name ${PM2_BACKEND_NAME:-backend}",
    "status": "pm2 status",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.ts\"",
    "check": "tsc --project tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,js,json}\" --ignore-path ../.prettierignore",
    "stop": "pm2 delete ${PM2_BACKEND_NAME:-backend}",
    "logtail": "AWS_PROFILE=machineid-prod-tf-user-main unbuffer aws logs tail '/ecs/prod-main-ecs-task-family-main' --follow | unbuffer -p grep -o '{.*' | jq --unbuffered",
    "build": "pnpm install --ignore-scripts && tsc -p tsconfig.json && tsc-alias",
    "confirm": "bash -c 'read -p \"Are you sure? [y/N] \" ans; [ \"$ans\" = \"y\" ] || exit 1' #internal",
    "db:case-format": "cp prisma/schema.prisma prisma/schema.prisma.generated && prisma-case-format -c prisma/prisma-case-format --file prisma/schema.prisma.generated #internal",
    "db:generate": "pnpm run db:case-format && prisma generate",
    "db:push": "pnpm run db:case-format && prisma db push",
    "db:migrate:create": "pnpm run db:case-format && prisma migrate dev --create-only",
    "db:migrate:deploy": "prisma migrate deploy && prisma generate",
    "db:migrate:status": "prisma migrate status",
    "gen:openapi": "tsx -r tsconfig-paths/register script/generate_openapi.ts"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.32.0",
    "@tsconfig/node20": "^20.1.6",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.16.5",
    "@types/nodemailer": "^7.0.1",
    "@types/pg": "^8.18.0",
    "@types/qrcode": "^1.5.5",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^9.1.2",
    "globals": "^15.15.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.6.2",
    "prisma": "^7.8.0",
    "prisma-case-format": "^2.2.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@aws-sdk/client-ssm": "^3.856.0",
    "@aws-sdk/s3-request-presigner": "^3.1103.0",
    "@date-fns/tz": "^1.5.0",
    "@fastify/autoload": "^6.3.1",
    "@fastify/caching": "^9.0.3",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.1.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^10.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "7.8.0",
    "@prisma/internals": "^7.8.0",
    "bcrypt": "^6.0.0",
    "date-fns": "^4.1.0",
    "fastify": "^5.4.0",
    "fastify-plugin": "^5.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "nodemailer": "^7.0.5",
    "only-allow": "^1.2.1",
    "openapi-typescript": "^7.8.0",
    "otpauth": "^9.5.1",
    "pg": "^8.20.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "tldts": "^6.1.86",
    "uuid": "^14.0.1",
    "youch": "^3.3.4",
    "zod": "^4.4.3"
  }
}
