# direnv 用。`direnv allow` で有効になる。
#
# IAM Identity Center(SSO)のプロファイル名だけを持つ。個人を特定する情報は入らない
# (docs/plans/20260806-aws-prod-setup.md のフェーズ 0-c)。
#
# セッションが切れたら: aws sso login --sso-session machineid --use-device-code --no-browser
export AWS_PROFILE=machineid-prod

# ---- ここから下は暫定。開発コンテナを再作成したら削除してよい ----
#
# compose の MinIO 用資格情報は S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY へ改名済みだが、
# **稼働中のコンテナには旧名(AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY)が残っている**。
# 環境変数はプロファイルより優先されるため、外さないと terraform / aws CLI が
# minioadmin を使って InvalidClientTokenId になる。
# コンテナ再作成後は旧名が存在しなくなるので、この 3 行は無意味になる
unset AWS_ACCESS_KEY_ID
unset AWS_SECRET_ACCESS_KEY
unset AWS_SESSION_TOKEN
