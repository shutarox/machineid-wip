{
  "name": "machineid-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.7.1",
  "scripts": {
    "h": "jq '.scripts' package.json | grep -v '#internal'",
    "preinstall": "only-allow pnpm #internal",
    "dev": "node ../tools/portcheck.js ${FRONTEND_PORT:-8800} && node ../tools/pm2check.js ${PM2_FRONTEND_NAME:-frontend} && pm2 start 'vite --port ${FRONTEND_PORT:-8800} 2>&1' --log-date-format 'YYYY-MM-DD HH:mm:ss.SSS' --name ${PM2_FRONTEND_NAME:-frontend}",
    "status": "pm2 status",
    "stop": "pm2 delete ${PM2_FRONTEND_NAME:-frontend}",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "check": "tsc --project tsconfig.app.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,scss}\" --ignore-path ../.prettierignore",
    "build": "pnpm lint && tsc -b && vite build",
    "preview": "pm2 start 'vite preview --port ${FRONTEND_PORT:-8800} 2>&1' --log-date-format 'YYYY-MM-DD HH:mm:ss.SSS' --name ${PM2_FRONTEND_NAME:-frontend}"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.25.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.12.5",
    "lucide-react": "^0.473.0",
    "openapi-fetch": "^0.13.8",
    "openapi-react-query": "0.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^5.0.0",
    "react-hook-form": "^7.84.0",
    "react-router-dom": "^7.7.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@eslint/js": "^9.32.0",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^15.15.0",
    "only-allow": "^1.2.1",
    "openapi-typescript-helpers": "^0.0.15",
    "prettier": "^3.6.2",
    "shadcn": "^4.16.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.38.0",
    "vite": "^8.1.4"
  }
}
