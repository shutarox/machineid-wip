{
  "autorun": true,
  "terminals": [
    {
      "name": "initialize",
      "cwd": "[workspaceFolder]",
      "commands": [
        ". [workspaceFolder]/tools/prevent_duplicate_shell.sh $$ initialize",
        "./tools/command_proxy.sh /bin/sh ./etc/initialize.sh 2>&1",
        "sleep 10 && exit 0"
      ]
    },
    {
      "name": "backend",
      "cwd": "[workspaceFolder]/backend",
      "commands": [
        "echo START `date '+%Y/%m/%d %H:%M:%S'` > ~/.pm2/logs/backend-out.log",
        ". [workspaceFolder]/tools/prevent_duplicate_shell.sh $$ backend",
        "tail -100f ~/.pm2/logs/backend-out.log"
      ]
    },
    {
      "name": "frontend",
      "cwd": "[workspaceFolder]/frontend",
      "commands": [
        "echo START `date '+%Y/%m/%d %H:%M:%S'` > ~/.pm2/logs/frontend-out.log",
        ". [workspaceFolder]/tools/prevent_duplicate_shell.sh $$ frontend",
        "tail -100f ~/.pm2/logs/frontend-out.log"
      ]
    }
  ]
}
