# image: machineid-stg:latest
# build: docker build -f ./Dockerfile.stg -t machineid-stg:latest .


FROM node:24.14.0-slim AS node

# --------- アプリのビルド ---------

FROM ubuntu:24.04 AS build

# **pnpm workspace 構成**(ルートに pnpm-lock.yaml と pnpm-workspace.yaml、
# パッケージは backend / frontend)。ロックファイルはルートに 1 本しかないので、
# backend だけを独立したプロジェクトのように扱うことはできない。
WORKDIR /app

COPY --from=node /usr/local/include/ /usr/local/include/
COPY --from=node /usr/local/lib/ /usr/local/lib/
COPY --from=node /usr/local/bin/ /usr/local/bin/

RUN npm install -g pnpm@10.7.1

# 依存の解決だけ先のレイヤーでやる(ソース変更でキャッシュを落とさないため)。
# --frozen-lockfile はロックとすべての package.json の整合を検査するので、
# **使わない frontend/package.json も置く必要がある**
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY backend/package.json  ./backend/
COPY frontend/package.json ./frontend/

RUN pnpm install --frozen-lockfile

# アプリビルド
COPY backend ./backend
WORKDIR /app/backend
# **prisma generate はここでは実行しない。**
# 生成物(src/generated/prisma と prisma/schema.prisma.generated)は**コミット運用**で、
# CI の check ジョブが「再生成して差分ゼロ」を検証している。
# かつ prisma.config.ts が env('DB_URL') を要求するため、ビルド時には解決できない。
RUN pnpm build \
    && find ./build -type f -name "*.map" -delete

# --------- ここから下は本番環境 ---------

FROM ubuntu:24.04 AS base

COPY --from=node /usr/local/include/ /usr/local/include/
COPY --from=node /usr/local/lib/ /usr/local/lib/
COPY --from=node /usr/local/bin/ /usr/local/bin/

# DEBIAN_FRONTEND=noninteractive は、tzdata のインストール時の
# 地域選択のインタラクティブなプロンプトを抑制するためのもの
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends wget gnupg ca-certificates \
    && wget -O- https://www.postgresql.org/media/keys/ACCC4CF8.asc | gpg --dearmor > /usr/share/keyrings/pgdg-archive-keyring.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/pgdg-archive-keyring.gpg] https://apt.postgresql.org/pub/repos/apt $(. /etc/os-release && echo $VERSION_CODENAME)-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && groupadd --gid 2000 appuser \
    && useradd --uid 2000 --gid appuser --shell /bin/bash --home-dir /app appuser \
    && apt-get install -y --no-install-recommends \
        tini \
        locales \
        tzdata \
        # **RDS のメジャーバージョンと合わせる**(terraform の engine_version = "18")。
        # pg_dump は自分より新しいサーバを拒否するため、古いままだと
        # ECS Exec で入ってもダンプが取れない
        postgresql-client-18 \
    && ln -snf /usr/share/zoneinfo/Asia/Tokyo /etc/localtime \
    && echo "Asia/Tokyo" > /etc/timezone \
    && locale-gen ja_JP.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# **所有者は appuser にする。** entrypoint が `su - appuser` でアプリを実行するため、
# root 所有のままだと prisma CLI がエンジンのディレクトリに書けず
# 「Can't write to .../@prisma/engines」で落ちる(実測)。
#
# **workspace の node_modules は symlink で構成される**
# (backend/node_modules/* → ../../node_modules/.pnpm/...)。
# 相対リンクなので、ルート側と backend 側を**同じ配置のまま両方**運ぶ必要がある。
# 片方だけだとリンク切れで起動しない。
COPY --from=build --chown=appuser:appuser /app/node_modules                 /app/node_modules
COPY --from=build --chown=appuser:appuser /app/backend/node_modules         /app/backend/node_modules

# repoRoot() は pnpm-workspace.yaml を上方探索してリポジトリルートを決める
# (libs/repoRoot.ts)。**これが無いと起動時に例外になる。**
COPY --from=build --chown=appuser:appuser /app/pnpm-workspace.yaml          /app/
COPY --from=build --chown=appuser:appuser /app/package.json                 /app/

COPY --from=build --chown=appuser:appuser /app/backend/build                /app/backend/build
COPY --from=build --chown=appuser:appuser /app/backend/package.json         /app/backend/

# prisma は**ディレクトリごと**入れる。`prisma migrate deploy` を run-task で流すのに
# migrations/ と schema.prisma.generated(prisma.config.ts の schema が指す先)が要るため。
# schema.prisma 単体では足りない。
#
# あわせて prisma.config.ts も要る: schema.prisma の datasource に url が書かれておらず、
# 接続先は prisma.config.ts の env('DB_URL') から解決されるため。
# 実行時の cwd は /app/backend にすること(CLI は cwd の prisma.config.ts を読む)。
#
# なお schema.prisma は**アプリの起動時にも読まれる**(libs/prisma-connection.ts が
# repoRoot() 基準で読み、@db.Date とテナント列のメタデータを組み立てる)ので必須。
COPY --from=build --chown=appuser:appuser /app/backend/prisma               /app/backend/prisma
COPY --from=build --chown=appuser:appuser /app/backend/prisma.config.ts     /app/backend/

COPY --chown=appuser:appuser etc/onstart-prod-main.sh           /app/etc/

# RDS の CA バンドル。
# **RDS は SSL 接続を要求する**が、@prisma/adapter-pg(node-postgres)は Node の信頼ストアで
# 検証するため、これが無いと `self-signed certificate in certificate chain` で接続できない(実測)。
# DB_URL 側は sslmode=require を付けること。
#
# なお `prisma migrate deploy` は別経路(スキーマエンジン)なので、これが無くても通ってしまう。
# 「マイグレーションは成功するのにアプリだけ繋がらない」という紛らわしい症状になる。
RUN wget -q -O /etc/ssl/certs/rds-global-bundle.pem \
    https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
ENV NODE_EXTRA_CA_CERTS=/etc/ssl/certs/rds-global-bundle.pem

ARG BUILD_VERSION
ENV APPX_BUILD_VERSION=${BUILD_VERSION}

ENV TZ=Asia/Tokyo
ENV LANG=ja_JP.UTF-8
ENV LC_MESSAGES=C
ENV LC_TIME=C

WORKDIR /app

EXPOSE 8080

ENTRYPOINT ["tini", "--", "bash", "/app/etc/onstart-prod-main.sh"]
