# terraform のプロバイダを全スタックで共有する。
#
# これが無いと、スタックごとに .terraform/ へ実体がコピーされる。
# AWS プロバイダは 1 つ約 758MB あり、prod だけで 4 スタックなので **3GB の重複**になる
# (実測 2026-08-06)。キャッシュを挟むと実体は 1 つになり、各スタックはリンクを持つだけになる。
#
# onstart-local.sh が docker/home-appuser-local/ 配下を ~ へコピーするので、
# コンテナを作り直しても設定が残る。
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"
