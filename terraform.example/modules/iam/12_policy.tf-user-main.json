{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "ec2:*",
        "route53:*",
        "cloudfront:*",
        "rds:*",
        "elasticloadbalancing:*",
        "cloudwatch:*",
        "logs:*",
        "s3:*",
        "acm:*",
        "events:*",
        "ecr:*",
        "ecs:*",
        "lambda:*",
        "sns:*",
        "codedeploy:*",
        "application-autoscaling:*",
        "iam:Get*",
        "iam:List*",
        "iam:PassRole",
        "iam:CreateRole",
        "iam:CreatePolicy",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeleteRole",
        "iam:CreateServiceLinkedRole",
        "kms:DescribeKey",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListKeys",
        "kms:ListAliases",
        "kms:ListResourceTags"
      ],
      "Resource": "*"
    }
  ]
}
